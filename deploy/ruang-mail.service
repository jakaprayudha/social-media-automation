[Unit]
Description=Ruang Social password reset mail batch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/ruang-social
ExecStart=/usr/bin/php /srv/ruang-social/bin/console.php mail:work
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ruang-social/var
TimeoutStartSec=120
